Keybinds: {
	"Deposit All.DisplayName": Deposit All
	"Loot All.DisplayName": Loot All
	"Quick Stack.DisplayName": Quick Stack
	Restock.DisplayName: Restock
	"Sort Chest.DisplayName": Sort Chest
	"Sort Inventory.DisplayName": Sort Inventory
	Ping.DisplayName: Ping
	"Focus search box.DisplayName": Focus search box
}

Configs: {
	BetterChestsConfig: {
		DisplayName: Better Chests Config

		disableDepositAllConfirmationButton: {
			Label: Disable Deposit All confirmation message
			Tooltip: Disables the "Are you sure?" message.
		}

		disableLootAllConfirmationButton: {
			Label: Disable Loot All confirmation message
			Tooltip: Disables the "Are you sure?" message.
		}

		disableSortConfirmationButton: {
			Label: Disable Sort confirmation message
			Tooltip: Disables the "Are you sure?" message.
		}

		defaultChestSortOptions: {
			Label: Default sort option
			Tooltip: Changes the functionality of the "Sort Items" button.
		}

		disableChestHover: {
			Label: Disable chest content display
			Tooltip: Disables the chest content display when you hover over a chest.
		}

		autoCloseSortingOptions: {
			Label: Automatically close sorting options
			Tooltip: Closes the sorting options every time you open a chest.
		}

		disableSearchbar: {
			Label: Remove searchbar
			Tooltip: Removes the search bar under chests.
		}

		disablePings: {
			Label: Disable Pings
			Tooltip: Disables the item ping functionality
		}

		pingHue: {
			Label: Ping color
			Tooltip: Sets the color of your pings
		}

		pingTime: {
			Label: Ping duration
			Tooltip: Sets how many seconds pings are visible
		}
	}

	BetterChestsMPConfig: {
		DisplayName: Better Chests Multiplayer Config

		disableChestOwnership: {
			Label: Disable Chest Ownership
			Tooltip: Disables the Chest Ownership system
		}
	}
}

